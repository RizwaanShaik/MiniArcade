<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="24dp"
    app:cardCornerRadius="28dp"
    app:cardBackgroundColor="@color/surface_elevated"
    app:cardElevation="16dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="24dp">

            <!-- Player Avatar -->
            <TextView
                android:id="@+id/tvAvatar"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_avatar_home"
                android:gravity="center"
                android:textSize="40sp"
                android:textColor="#FF000000"
                tools:text="🎮"/>

            <!-- Player Name -->
            <TextView
                android:id="@+id/tvPlayerName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="22sp"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:layout_marginTop="12dp"
                tools:text="Player Name"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🏆 Best Scores"
                android:textSize="14sp"
                android:textColor="@color/game_yellow"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:layout_marginTop="16dp"/>

            <!-- Best Scores Container -->
            <LinearLayout
                android:id="@+id/scoresLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="12dp"
                android:padding="12dp"
                android:background="@drawable/bg_stat_card">

                <!-- Reaction Time -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚡"
                        android:textSize="18sp"
                        android:textColor="#FF000000"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Reaction Time"
                        android:textSize="13sp"
                        android:textColor="@color/text_primary"
                        android:fontFamily="sans-serif"
                        android:paddingStart="10dp"/>

                    <TextView
                        android:id="@+id/tvReactionScore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:textColor="@color/game_cyan"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        tools:text="245ms"/>

                </LinearLayout>

                <!-- Memory Flip -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🧠"
                        android:textSize="18sp"
                        android:textColor="#FF000000"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Memory Flip"
                        android:textSize="13sp"
                        android:textColor="@color/text_primary"
                        android:fontFamily="sans-serif"
                        android:paddingStart="10dp"/>

                    <TextView
                        android:id="@+id/tvMemoryScore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:textColor="@color/game_green"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        tools:text="24 moves"/>

                </LinearLayout>

                <!-- Pattern Snap -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎯"
                        android:textSize="18sp"
                        android:textColor="#FF000000"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Pattern Snap"
                        android:textSize="13sp"
                        android:textColor="@color/text_primary"
                        android:fontFamily="sans-serif"
                        android:paddingStart="10dp"/>

                    <TextView
                        android:id="@+id/tvPatternScore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:textColor="@color/game_orange"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        tools:text="1250"/>

                </LinearLayout>

                <!-- Color Catch -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🌈"
                        android:textSize="18sp"
                        android:textColor="#FF000000"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Color Catch"
                        android:textSize="13sp"
                        android:textColor="@color/text_primary"
                        android:fontFamily="sans-serif"
                        android:paddingStart="10dp"/>

                    <TextView
                        android:id="@+id/tvColorScore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:textColor="@color/game_yellow"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        tools:text="980"/>

                </LinearLayout>

                <!-- Word Scramble -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📝"
                        android:textSize="18sp"
                        android:textColor="#FF000000"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Word Scramble"
                        android:textSize="13sp"
                        android:textColor="@color/text_primary"
                        android:fontFamily="sans-serif"
                        android:paddingStart="10dp"/>

                    <TextView
                        android:id="@+id/tvWordScore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:textColor="@color/game_purple"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        tools:text="150"/>

                </LinearLayout>

                <!-- Rhythm Tap -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎵"
                        android:textSize="18sp"
                        android:textColor="#FF000000"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Rhythm Tap"
                        android:textSize="13sp"
                        android:textColor="@color/text_primary"
                        android:fontFamily="sans-serif"
                        android:paddingStart="10dp"/>

                    <TextView
                        android:id="@+id/tvRhythmScore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:textColor="@color/game_blue"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        tools:text="2100"/>

                </LinearLayout>

            </LinearLayout>

            <!-- Close Button -->
            <Button
                android:id="@+id/btnClose"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="20dp"
                android:text="Close"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:fontFamily="sans-serif-medium"
                android:background="@drawable/bg_button_primary"/>

        </LinearLayout>

    </ScrollView>

</androidx.cardview.widget.CardView>

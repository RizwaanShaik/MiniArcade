<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_game">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="@dimen/spacing_md"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_card_rounded"
            android:src="@android:drawable/ic_menu_revert"
            android:contentDescription="Back"
            android:padding="10dp"
            app:tint="@color/white"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="⚡ Reaction Time"
            android:textSize="22sp"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:fontFamily="@font/poppins"
            android:gravity="center"/>

        <TextView
            android:id="@+id/tvRound"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:textStyle="bold"
            android:background="@drawable/bg_stat_card"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            tools:text="1/5"/>

    </LinearLayout>

    <!-- Stats Row -->
    <LinearLayout
        android:id="@+id/statsRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingHorizontal="@dimen/spacing_xl"
        android:paddingVertical="@dimen/spacing_sm"
        app:layout_constraintTop_toBottomOf="@id/headerLayout">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_stat_card"
            android:padding="16dp"
            android:layout_marginEnd="8dp">

            <TextView
                android:id="@+id/tvBestTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="24sp"
                android:textColor="@color/game_yellow"
                android:textStyle="bold"
                android:fontFamily="@font/poppins"
                android:text="---"
                tools:text="256"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🏆 Best (ms)"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:fontFamily="@font/poppins"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_stat_card"
            android:padding="16dp"
            android:layout_marginStart="8dp">

            <TextView
                android:id="@+id/tvAvgTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="24sp"
                android:textColor="@color/game_cyan"
                android:textStyle="bold"
                android:fontFamily="@font/poppins"
                android:text="---"
                tools:text="312"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📊 Average (ms)"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:fontFamily="@font/poppins"/>

        </LinearLayout>

    </LinearLayout>

    <!-- Tap Area (gameArea) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/gameAreaCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="@dimen/spacing_lg"
        app:cardCornerRadius="32dp"
        app:cardElevation="8dp"
        app:layout_constraintTop_toBottomOf="@id/statsRow"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <FrameLayout
            android:id="@+id/gameArea"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_reaction_red">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:id="@+id/tvInstruction"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="28sp"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:fontFamily="@font/poppins"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.2"
                    android:text="TAP TO START"
                    tools:text="TAP TO START"/>

                <TextView
                    android:id="@+id/tvSubtext"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:textColor="#AAFFFFFF"
                    android:gravity="center"
                    android:layout_marginTop="12dp"
                    android:fontFamily="@font/poppins"
                    android:text="Tap anywhere to begin"
                    tools:text="Tap anywhere to begin"/>

                <!-- Penalty Display -->
                <LinearLayout
                    android:id="@+id/penaltyLayout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:background="@drawable/bg_stat_card"
                    android:paddingHorizontal="24dp"
                    android:paddingVertical="14dp"
                    android:layout_marginTop="20dp"
                    android:visibility="gone"
                    android:alpha="0.95"
                    tools:visibility="visible">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚡"
                        android:textSize="22sp"
                        android:layout_marginEnd="10dp"/>

                    <TextView
                        android:id="@+id/tvPenalty"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="20sp"
                        android:textColor="#FF6B35"
                        android:textStyle="bold"
                        android:fontFamily="@font/poppins_bold"
                        android:text="+50ms penalty"
                        tools:text="+50ms penalty"/>

                </LinearLayout>

                <TextView
                    android:id="@+id/tvTryAgain"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:textColor="#CCFFFFFF"
                    android:gravity="center"
                    android:layout_marginTop="12dp"
                    android:visibility="gone"
                    android:fontFamily="@font/poppins_medium"
                    android:text="Tap to try again"
                    tools:text="Tap to try again"
                    tools:visibility="visible"/>

                <TextView
                    android:id="@+id/tvReactionTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="64sp"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:fontFamily="@font/poppins"
                    android:visibility="gone"
                    android:layout_marginTop="16dp"
                    tools:text="256"
                    tools:visibility="visible"/>

                <TextView
                    android:id="@+id/tvReactionLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="20sp"
                    android:textColor="#CCFFFFFF"
                    android:visibility="gone"
                    android:fontFamily="@font/poppins"
                    android:text="milliseconds"
                    tools:visibility="visible"/>

            </LinearLayout>

        </FrameLayout>

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>

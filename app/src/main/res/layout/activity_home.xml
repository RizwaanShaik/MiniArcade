<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_primary">

    <!-- Header with gradient - extends behind status bar -->
    <View
        android:id="@+id/headerGradient"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:background="@drawable/bg_header_gradient"
        app:layout_constraintTop_toTopOf="parent"/>

    <!-- Header Content - padding applied programmatically for status bar -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Avatar - clickable to show stats -->
        <TextView
            android:id="@+id/tvAvatar"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_avatar_home"
            android:gravity="center"
            android:textSize="32sp"
            android:textColor="#FF000000"
            android:elevation="4dp"
            android:clickable="true"
            android:focusable="true"
            tools:text="🎮"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="16dp">

            <TextView
                android:id="@+id/tvGreeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="22sp"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:fontFamily="@font/poppins_semibold"
                tools:text="Hi, Riz! 👋"/>

            <TextView
                android:id="@+id/tvChooseGame"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/choose_game"
                android:textSize="20sp"
                android:textColor="@color/text_secondary"
                android:fontFamily="@font/poppins"
                android:layout_marginTop="4dp"/>

        </LinearLayout>

        <!-- Leaderboard button with trophy emoji -->
        <TextView
            android:id="@+id/btnLeaderboard"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_leaderboard_button"
            android:text="🏆"
            android:textSize="28sp"
            android:gravity="center"
            android:textColor="#FF000000"
            android:contentDescription="@string/leaderboard"/>

    </LinearLayout>

    <!-- Games Grid -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvGames"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:padding="12dp"
        android:clipToPadding="false"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"
        app:layout_constraintBottom_toTopOf="@id/btnLogout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Logout Button -->
    <Button
        android:id="@+id/btnLogout"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="16dp"
        android:text="Switch Player/Logout"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/game_red"
        android:fontFamily="@font/poppins_medium"
        android:background="@drawable/bg_button_logout"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>

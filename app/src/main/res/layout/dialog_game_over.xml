<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="24dp"
    app:cardCornerRadius="28dp"
    app:cardBackgroundColor="@color/surface_elevated"
    app:cardElevation="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="28dp">

        <!-- Result Emoji -->
        <TextView
            android:id="@+id/tvResultEmoji"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="64sp"
            android:textColor="#FF000000"
            tools:text="🏆"/>

        <!-- New High Score Badge - Show BEFORE title if new highscore -->
        <TextView
            android:id="@+id/tvNewHighScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🏆 NEW HIGH SCORE! 🏆"
            android:textSize="18sp"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:fontFamily="@font/poppins_bold"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            android:paddingHorizontal="20dp"
            android:paddingVertical="10dp"
            android:background="@drawable/bg_card_rounded"
            android:backgroundTint="@color/game_yellow"
            android:elevation="8dp"
            tools:visibility="visible"/>

        <!-- Personal Best Badge - Show if personal best but not new highscore -->
        <TextView
            android:id="@+id/tvPersonalBest"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⭐ PERSONAL BEST! ⭐"
            android:textSize="16sp"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:fontFamily="@font/poppins_bold"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            android:paddingHorizontal="20dp"
            android:paddingVertical="10dp"
            android:background="@drawable/bg_card_rounded"
            android:backgroundTint="@color/game_orange"
            android:elevation="8dp"
            tools:visibility="gone"/>

        <!-- Title -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="24sp"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:fontFamily="@font/poppins_semibold"
            android:layout_marginTop="12dp"
            tools:text="Amazing!"/>

        <!-- Score with gradient background -->
        <TextView
            android:id="@+id/tvScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:textColor="@color/game_yellow"
            android:textStyle="bold"
            android:fontFamily="@font/poppins_medium"
            android:layout_marginTop="4dp"
            tools:text="Score: 1,250"/>

        <!-- Perfect Badge - Show under score for perfect rounds -->
        <TextView
            android:id="@+id/tvPerfect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✨ PERFECT ✨"
            android:textSize="14sp"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:fontFamily="@font/poppins_bold"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp"
            android:background="@drawable/bg_card_rounded"
            android:backgroundTint="@color/game_green"
            android:elevation="4dp"
            tools:visibility="gone"/>

        <!-- Stats Container -->
        <LinearLayout
            android:id="@+id/statsLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="20dp"
            android:visibility="gone"
            tools:visibility="visible">

            <!-- Stat 1 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="12dp"
                android:background="@drawable/bg_stat_card">

                <TextView
                    android:id="@+id/tvStat1Value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="22sp"
                    android:textColor="@color/game_cyan"
                    android:textStyle="bold"
                    android:fontFamily="@font/poppins_semibold"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:gravity="center"
                    tools:text="180"/>

                <TextView
                    android:id="@+id/tvStat1Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary"
                    android:fontFamily="@font/poppins"
                    android:layout_marginTop="2dp"
                    tools:text="Level"/>

            </LinearLayout>

            <Space
                android:layout_width="10dp"
                android:layout_height="match_parent"/>

            <!-- Stat 2 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="12dp"
                android:background="@drawable/bg_stat_card">

                <TextView
                    android:id="@+id/tvStat2Value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="22sp"
                    android:textColor="@color/game_orange"
                    android:textStyle="bold"
                    android:fontFamily="@font/poppins_semibold"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:gravity="center"
                    tools:text="312"/>

                <TextView
                    android:id="@+id/tvStat2Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary"
                    android:fontFamily="@font/poppins"
                    android:layout_marginTop="2dp"
                    tools:text="Streak"/>

            </LinearLayout>

        </LinearLayout>

        <!-- Leaderboard Section -->
        <LinearLayout
            android:id="@+id/leaderboardLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="20dp"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🏆 Top 3"
                android:textSize="14sp"
                android:textColor="@color/game_yellow"
                android:textStyle="bold"
                android:fontFamily="@font/poppins_medium"
                android:layout_gravity="center"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp"
                android:padding="12dp"
                android:background="@drawable/bg_stat_card">

                <!-- Rank 1 -->
                <LinearLayout
                    android:id="@+id/rank1Layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="6dp">

                    <TextView
                        android:layout_width="24dp"
                        android:layout_height="wrap_content"
                        android:text="🥇"
                        android:textSize="16sp"
                        android:gravity="center"/>

                    <TextView
                        android:id="@+id/tvRank1Name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="13sp"
                        android:textColor="@color/text_primary"
                        android:fontFamily="@font/poppins"
                        android:paddingStart="8dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        tools:text="Player1"/>

                    <TextView
                        android:id="@+id/tvRank1Score"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:textColor="@color/game_yellow"
                        android:textStyle="bold"
                        android:fontFamily="@font/poppins_medium"
                        tools:text="1250"/>

                </LinearLayout>

                <!-- Rank 2 -->
                <LinearLayout
                    android:id="@+id/rank2Layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="6dp">

                    <TextView
                        android:layout_width="24dp"
                        android:layout_height="wrap_content"
                        android:text="🥈"
                        android:textSize="16sp"
                        android:gravity="center"/>

                    <TextView
                        android:id="@+id/tvRank2Name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="13sp"
                        android:textColor="@color/text_primary"
                        android:fontFamily="@font/poppins"
                        android:paddingStart="8dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        tools:text="Player2"/>

                    <TextView
                        android:id="@+id/tvRank2Score"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:textColor="@color/text_secondary"
                        android:textStyle="bold"
                        android:fontFamily="@font/poppins_medium"
                        tools:text="980"/>

                </LinearLayout>

                <!-- Rank 3 -->
                <LinearLayout
                    android:id="@+id/rank3Layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="6dp">

                    <TextView
                        android:layout_width="24dp"
                        android:layout_height="wrap_content"
                        android:text="🥉"
                        android:textSize="16sp"
                        android:gravity="center"/>

                    <TextView
                        android:id="@+id/tvRank3Name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="13sp"
                        android:textColor="@color/text_primary"
                        android:fontFamily="@font/poppins"
                        android:paddingStart="8dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        tools:text="Player3"/>

                    <TextView
                        android:id="@+id/tvRank3Score"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:textColor="@color/text_secondary"
                        android:textStyle="bold"
                        android:fontFamily="@font/poppins_medium"
                        tools:text="750"/>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="24dp"
            android:gravity="center">

            <Button
                android:id="@+id/btnMenu"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/menu"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:fontFamily="@font/poppins_semibold"
                android:background="@drawable/bg_button_outline"
                android:backgroundTint="@android:color/transparent"
                android:minHeight="0dp"
                android:elevation="0dp"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/btnPlayAgain"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1.2"
                android:text="@string/play_again"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:fontFamily="@font/poppins_semibold"
                android:background="@drawable/bg_button_primary"
                android:minHeight="0dp"
                android:elevation="4dp"
                android:layout_marginStart="8dp"/>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>

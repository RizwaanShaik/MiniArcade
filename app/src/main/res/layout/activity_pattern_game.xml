<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_game">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="@dimen/spacing_md"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_card_rounded"
            android:src="@android:drawable/ic_menu_revert"
            android:contentDescription="Back"
            android:padding="10dp"
            app:tint="@color/white"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/game_pattern"
            android:textSize="20sp"
            android:textColor="@color/text_primary"
            android:textStyle="bold" android:fontFamily="@font/poppins"
            android:gravity="center"/>

        <!-- Spacer to balance header -->
        <View
            android:layout_width="44dp"
            android:layout_height="44dp"/>

    </LinearLayout>

    <!-- Score & Lives -->
    <LinearLayout
        android:id="@+id/statsBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingHorizontal="@dimen/spacing_lg"
        android:paddingVertical="@dimen/spacing_sm"
        app:layout_constraintTop_toBottomOf="@id/headerLayout">

        <TextView
            android:id="@+id/tvScore"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="16sp"
            android:textColor="@color/game_yellow"
            android:textStyle="bold" android:fontFamily="@font/poppins"
            android:gravity="center"
            tools:text="Score: 0"/>

        <TextView
            android:id="@+id/tvLives"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="22sp"
            android:textColor="#FF000000"
            android:gravity="center"
            tools:text="❤️❤️❤️"/>

    </LinearLayout>

    <!-- Instruction -->
    <TextView
        android:id="@+id/tvInstruction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/watch_pattern"
        android:textSize="22sp"
        android:textColor="@color/text_primary"
        android:textStyle="bold" android:fontFamily="@font/poppins"
        android:layout_marginTop="@dimen/spacing_xl"
        app:layout_constraintTop_toBottomOf="@id/statsBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Pattern Display Area - Used when showing the pattern -->
    <com.google.android.flexbox.FlexboxLayout
        android:id="@+id/patternDisplayArea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xl"
        android:layout_marginHorizontal="@dimen/spacing_lg"
        android:padding="@dimen/spacing_sm"
        app:flexWrap="wrap"
        app:justifyContent="center"
        app:alignItems="center"
        app:alignContent="center"
        app:layout_constraintTop_toBottomOf="@id/tvInstruction"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- User Selection Area (ABOVE options - selected emojis go here) - HEIGHT FOR 2 LINES -->
    <com.google.android.flexbox.FlexboxLayout
        android:id="@+id/userSelectionArea"
        android:layout_width="match_parent"
        android:layout_height="130dp"
        android:layout_marginTop="@dimen/spacing_lg"
        android:layout_marginHorizontal="@dimen/spacing_lg"
        android:padding="@dimen/spacing_sm"
        android:visibility="gone"
        app:flexWrap="wrap"
        app:justifyContent="center"
        app:alignItems="center"
        app:alignContent="center"
        app:layout_constraintTop_toBottomOf="@id/patternDisplayArea"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Clear Button - enhanced with better styling -->
    <Button
        android:id="@+id/btnClear"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="🗑️ Clear"
        android:textSize="14sp"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:fontFamily="@font/poppins"
        android:background="@drawable/bg_card_rounded"
        android:backgroundTint="@color/game_red"
        android:paddingHorizontal="20dp"
        android:paddingVertical="10dp"
        android:visibility="gone"
        android:elevation="4dp"
        app:layout_constraintTop_toBottomOf="@id/userSelectionArea"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Options Grid (BELOW selection area - scrambled options stay here) -->
    <com.google.android.flexbox.FlexboxLayout
        android:id="@+id/optionsGrid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_md"
        android:layout_marginHorizontal="@dimen/spacing_lg"
        android:padding="@dimen/spacing_md"
        android:visibility="gone"
        app:flexWrap="wrap"
        app:justifyContent="center"
        app:alignItems="center"
        app:alignContent="center"
        app:layout_constraintTop_toBottomOf="@id/btnClear"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Start Overlay (same as other games) -->
    <FrameLayout
        android:id="@+id/startOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000"
        tools:layout_editor_absoluteX="-40dp"
        tools:layout_editor_absoluteY="76dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🧩"
                android:textSize="72sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/poppins"
                android:text="Pattern Snap"
                android:textColor="@color/text_primary"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Remember and repeat the pattern!"
                android:textColor="@color/text_secondary"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btnStart"
                android:layout_width="200dp"
                android:layout_height="56dp"
                android:layout_marginTop="32dp"
                android:background="@drawable/bg_button_primary"
                android:fontFamily="@font/poppins"
                android:text="@string/tap_to_start"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

        </LinearLayout>

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
